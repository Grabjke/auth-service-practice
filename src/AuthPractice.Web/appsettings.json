{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authorization": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Port=5432;Database=auth_practice;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "auth-practice",
    "Audience": "auth-practice-api",
    "ExpireMinutes": 3,
    "SigningKey": ""
  },
  "RefreshToken": {
    "LifetimeDays": 7,
    "FamilyLifetimeDays": 30,
    "CookieName": "refresh_token",
    "CookiePath": "/api/auth/jwt",
    "ConcurrentRefreshGraceSeconds": 10
  }
}
