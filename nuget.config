<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org + приватный фид github (пакеты SharedKernel / Core / Framework из Grabjke/shared).
  Креды для "github" НЕ храним в репо — они в ~/.nuget/NuGet/NuGet.Config (см. README).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/Grabjke/index.json" />
  </packageSources>
</configuration>
